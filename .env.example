# Copy this file to .env, then paste the real values from the pinned Discord message.
# Never commit .env. That file stays on your computer.
# Any variable whose name starts with VITE_ is shipped to the browser, so users can read it.
# Never put a secret in this file. Never put the Supabase service_role key (also called the secret key) here.
# The only Supabase key that belongs here is the public anon key, also called the publishable key.

# Address of our Supabase project.
# Supabase dashboard → Project Settings → API → Project URL.

VITE_SUPABASE_URL=example_key

# Public anon / publishable key. This one is safe to use in the browser.
# Supabase dashboard → Project Settings → API → anon public, or publishable key.
# Do not paste the service_role key or the secret key.

VITE_SUPABASE_ANON_KEY=example_key

# Public key for web push notifications. Leave this empty until we set up push.
VITE_VAPID_PUBLIC_KEY=example_key
